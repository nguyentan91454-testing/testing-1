# Stage 1: Build backend API
FROM node:22-alpine AS api-builder
WORKDIR /app

# Copy monorepo config files
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
COPY prisma ./prisma

# Install all deps
RUN npm ci --ignore-scripts

# Build shared package first
RUN npm run build --workspace=@techstore/shared

# Generate Prisma client
RUN npx prisma generate

# Build API
RUN npm run build --workspace=@techstore/api

# Stage 2: Production runtime
FROM node:22-alpine AS api-runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Install only production deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/

RUN npm ci --omit=dev --ignore-scripts

# Copy build artifacts
COPY --from=api-builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=api-builder /app/apps/api/dist ./apps/api/dist
COPY --from=api-builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=api-builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=api-builder /app/prisma ./prisma

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:5000/health || exit 1

CMD ["node", "apps/api/dist/server.js"]
