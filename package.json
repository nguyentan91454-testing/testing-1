{
  "name": "home-decor-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev:web": "pnpm --filter @commerce/web dev",
    "dev:api": "pnpm --filter @commerce/api dev",
    "build:web": "pnpm --filter @commerce/web build",
    "build": "pnpm --filter @commerce/api build && pnpm --filter @commerce/web build",
    "typecheck": "pnpm --filter @commerce/api typecheck && pnpm --filter @commerce/web typecheck",
    "test": "pnpm --filter @commerce/api test",
    "db:generate": "pnpm --filter @commerce/api db:generate",
    "db:migrate": "pnpm --filter @commerce/api db:migrate",
    "db:seed": "pnpm --filter @commerce/api db:seed"
  }
}

