# ===================================================================
# TECHSTORE E-COMMERCE CONFIGURATION
# ===================================================================

# Environment: development | production | test
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:5173

# Database (PostgreSQL or SQLite for quick local test)
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/techstore_db?schema=public
# SQLite (zero setup): file:./dev.db
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional, fallback to high-speed In-Memory cache if unavailable)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="false"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-jwt-access-token-key-change-in-prod-2026"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-token-key-change-in-prod-2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Configuration
COOKIE_SECRET="cookie-signing-secret-key-super-secure"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# ===================================================================
# 🤖 AI CHATBOT — Google Gemini Configuration
# ===================================================================
# 1. Truy cập: https://aistudio.google.com/app/apikey
# 2. Nhấn "Create API key" → Copy key bắt đầu bằng "AIza..."
# 3. Dán vào AI_API_KEY bên dưới
#
# Nếu để trống → Chatbot chạy offline (local fallback, không cần key)
# ===================================================================
AI_PROVIDER="gemini"
AI_API_KEY="AIza..."
AI_MODEL="gemini-2.0-flash"
AI_TEMPERATURE="0.2"

# Payment Gateways (Mock / Sandbox)
MOCK_PAYMENT_ENABLED="true"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VNPAY_TMN_CODE="your_vnpay_tmn"
VNPAY_HASH_SECRET="your_vnpay_secret"

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20
