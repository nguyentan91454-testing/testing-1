NODE_ENV=development
API_PORT=4000
API_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://ecommerce:ecommerce_dev@localhost:5432/ecommerce?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-use
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOW_MOCK_PAYMENTS=false
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Firebase project settings from Firebase Console > Project settings > Your apps.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
RESEND_API_KEY=
# Gmail SMTP: use an App Password created after enabling Google 2-Step Verification.
# Gmail takes priority over Resend when both Gmail fields are configured.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Development only: verification emails go to Mailpit if Gmail and Resend are absent.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
EMAIL_FROM=Home & Decor <onboarding@resend.dev>

